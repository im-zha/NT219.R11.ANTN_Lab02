# Send only build inputs; everything else (including .git and local builds) stays out.
**
!Dockerfile
!.dockerignore
!CMakeLists.txt
!AES.cpp
!modes/
!modes/CMakeLists.txt
!modes/include/
!modes/include/*.hpp
!modes/include/*.h
!modes/src/
!modes/src/*.cpp
!modes/tests/
!modes/tests/*.cpp
!modes/tests/*.c
!modes/tests/*.h
!modes/tests/*.hpp
!modes/tests/*.py
!modes/cmake/
!modes/cmake/*.cmake
!modes/cmake/*.cmake.in
!examples/
!examples/python/
!examples/python/*.py
!examples/cpp/
!examples/cpp/CMakeLists.txt
!examples/cpp/main.cpp
